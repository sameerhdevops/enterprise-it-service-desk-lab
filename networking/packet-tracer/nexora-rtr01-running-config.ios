! Current Configuration - NEX-RTR01 (Cisco 2911 Integrated Services Router)
! Nexora Technologies - Bengaluru Headquarters Office Gateway
! Architecture: Router-on-a-Stick (802.1Q Inter-VLAN Routing & PAT)
!
version 15.1
service timestamps debug datetime msec
service timestamps log datetime msec
!
hostname NEX-RTR01
!
boot-start-marker
boot-end-marker
!
! User Access Security & AAA
! Security Note: Cisco Type 7 passwords ('service password-encryption') use a trivially
! reversible XOR/Vigenère cipher and are not cryptographically secure.
! Use Cisco Type 8 (PBKDF2-SHA256) or Type 9 (scrypt) secrets in operational environments.
username admin privilege 15 secret <LOCAL_ADMIN_SECRET>
enable secret <LOCAL_ENABLE_SECRET>
!
! Domain Name & SSH Configuration
! Note: Cisco IOS requires an active domain name and generated RSA keys for SSH:
! NEX-RTR01(config)# crypto key generate rsa modulus 2048
ip domain-name nexora.test
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3
!
no aaa new-model
!
! IP DHCP Pool Configuration (Router-Managed DHCP Architecture)
! Note: DHCP is handled locally by NEX-RTR01 for VLAN 10 and VLAN 20.
! Conflicting 'ip helper-address' relay statements have been omitted from Gi0/1.10.
ip dhcp excluded-address 192.168.10.1 192.168.10.20
ip dhcp excluded-address 192.168.20.1 192.168.20.20
!
ip dhcp pool VLAN10_CORP_USERS
 network 192.168.10.0 255.255.255.0
 default-router 192.168.10.1 
 dns-server 192.168.20.10 8.8.8.8 
 domain-name nexora.test
 lease 7
!
ip dhcp pool VLAN20_SERVERS
 network 192.168.20.0 255.255.255.0
 default-router 192.168.20.1 
 dns-server 192.168.20.10 
 domain-name nexora.test
!
! Interfaces
! WAN Uplink to Primary ISP
interface GigabitEthernet0/0
 description WAN Uplink to Primary ISP NOC
 ip address 203.0.113.2 255.255.255.252
 ip nat outside
 duplex auto
 speed auto
!
! Physical Trunk Port to Core Switch SW-CORE-01
interface GigabitEthernet0/1
 description 802.1Q Trunk Link to SW-CORE-01 g0/1
 no ip address
 duplex auto
 speed auto
!
! Subinterface for VLAN 10 (Corporate User LAN)
interface GigabitEthernet0/1.10
 description Corporate Users (HR, Finance, Operations, IT, Sales, Engineering)
 encapsulation dot1Q 10
 ip address 192.168.10.1 255.255.255.0
 ip nat inside
!
! Subinterface for VLAN 20 (Server Farm & Infrastructure)
interface GigabitEthernet0/1.20
 description Corporate Server Farm (DC, File, Print, App)
 encapsulation dot1Q 20
 ip address 192.168.20.1 255.255.255.0
 ip access-group 101 out
 ip nat inside
!
! Subinterface for VLAN 99 (In-Band Management)
interface GigabitEthernet0/1.99
 description Network Device In-Band Management SVI
 encapsulation dot1Q 99
 ip address 192.168.99.1 255.255.255.0
!
! Default Route to ISP Gateway
ip route 0.0.0.0 0.0.0.0 203.0.113.1
!
! NAT Overload (PAT) for Outbound Internet Access
ip nat inside source list 1 interface GigabitEthernet0/0 overload
access-list 1 permit 192.168.10.0 0.0.0.255
access-list 1 permit 192.168.20.0 0.0.0.255
!
! Access Control List 101 - Server Farm Ingress Protection
! Applied 'out' on GigabitEthernet0/1.20: filters packets exiting the router into VLAN 20.
! Server response packets destined back to users enter Gi0/1.20 in and exit Gi0/1.10 out,
! ensuring return traffic is never blocked.
access-list 101 remark === Permitted Corporate User Access to Server Farm ===
! SMB / CIFS File Sharing (TCP 445)
access-list 101 permit tcp 192.168.10.0 0.0.0.255 host 192.168.20.10 eq 445
! Kerberos Authentication & Key Distribution (TCP/UDP 88)
access-list 101 permit tcp 192.168.10.0 0.0.0.255 host 192.168.20.10 eq 88
access-list 101 permit udp 192.168.10.0 0.0.0.255 host 192.168.20.10 eq 88
! Kerberos Password Change Service (TCP/UDP 464)
access-list 101 permit tcp 192.168.10.0 0.0.0.255 host 192.168.20.10 eq 464
access-list 101 permit udp 192.168.10.0 0.0.0.255 host 192.168.20.10 eq 464
! Active Directory LDAP Directory Service (TCP/UDP 389)
access-list 101 permit tcp 192.168.10.0 0.0.0.255 host 192.168.20.10 eq 389
access-list 101 permit udp 192.168.10.0 0.0.0.255 host 192.168.20.10 eq 389
! Domain Name System (UDP/TCP 53)
access-list 101 permit udp 192.168.10.0 0.0.0.255 host 192.168.20.10 eq 53
access-list 101 permit tcp 192.168.10.0 0.0.0.255 host 192.168.20.10 eq 53
! ICMP Echo for Diagnostic Reachability Verification
access-list 101 permit icmp 192.168.10.0 0.0.0.255 host 192.168.20.10 echo
! Explicit Deny for all other unapproved traffic with syslog logging
access-list 101 deny ip any any log
!
line con 0
 login local
line vty 0 4
 login local
 transport input ssh
!
end
