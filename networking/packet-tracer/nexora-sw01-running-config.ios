! Current Configuration - SW-CORE-01 (Cisco Catalyst 2960-24TT Switch)
! Nexora Technologies - Floor 2 Distribution Switch
! Architecture: Layer 2 Access & 802.1Q Trunk with Port Security & STP PortFast
!
version 15.0
service timestamps debug datetime msec
service timestamps log datetime msec
!
hostname SW-CORE-01
!
! User Access Security
! Security Note: Cisco Type 7 passwords ('service password-encryption') use a trivially
! reversible XOR/Vigenère cipher and are not cryptographically secure.
! Use Cisco Type 8 (PBKDF2-SHA256) or Type 9 (scrypt) secrets in operational environments.
username admin privilege 15 secret <LOCAL_ADMIN_SECRET>
enable secret <LOCAL_ENABLE_SECRET>
!
! VLAN Database
vlan 10
 name Corp_Users
!
vlan 20
 name Server_Farm
!
vlan 99
 name Management
!
! Management SVI
interface Vlan99
 description In-Band Management SVI
 ip address 192.168.99.2 255.255.255.0
 no shutdown
!
ip default-gateway 192.168.99.1
!
! 802.1Q Trunk Link to Router NEX-RTR01
interface GigabitEthernet0/1
 description 802.1Q Trunk Link to Router NEX-RTR01 g0/1
 switchport mode trunk
 switchport trunk allowed vlan 10,20,99
 switchport nonegotiate
!
! Access Ports for Corporate User Desktops & Laptops (VLAN 10)
interface range FastEthernet0/1 - 16
 description Workstations - VLAN 10 (PortFast & BPDU Guard Enabled)
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
 spanning-tree bpduguard enable
 switchport port-security
 switchport port-security maximum 2
 switchport port-security violation restrict
 switchport port-security mac-address sticky
!
! Access Ports for Network Printers (VLAN 10)
interface range FastEthernet0/17 - 18
 description Network Printers - VLAN 10
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
!
! Access Ports for Corporate Server Farm (VLAN 20)
interface range FastEthernet0/19 - 24
 description Corporate Servers (DC, FS, APP) - VLAN 20
 switchport mode access
 switchport access vlan 20
 spanning-tree portfast
!
line con 0
 login local
line vty 0 4
 login local
 transport input ssh
!
end
